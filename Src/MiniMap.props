<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MiniMapDebugUI Condition="'$(MiniMapDebugUI)' == ''">true</MiniMapDebugUI>
    <!-- Independent development gate for unfinished Stage C visuals; safe default is OFF. -->
    <MiniMapStageCVisuals Condition="'$(MiniMapStageCVisuals)' == ''">false</MiniMapStageCVisuals>
    <!-- R1 is independent of Stage C visuals and never enabled by default. -->
    <MiniMapAsyncReadbackExperiment Condition="'$(MiniMapAsyncReadbackExperiment)' == ''">false</MiniMapAsyncReadbackExperiment>
    <!-- R2 diagnostic capture/export is enabled in normal Client Release builds. -->
    <MiniMapStageR2SmelterCapture Condition="'$(MiniMapStageR2SmelterCapture)' == '' And '$(Configuration)' == 'Client Release'">true</MiniMapStageR2SmelterCapture>
    <MiniMapStageR2SmelterCapture Condition="'$(MiniMapStageR2SmelterCapture)' == ''">false</MiniMapStageR2SmelterCapture>
    <MiniMapStageR25bStaticAssembly Condition="'$(MiniMapStageR25bStaticAssembly)' == '' And '$(Configuration)' == 'Client Release'">true</MiniMapStageR25bStaticAssembly>
    <MiniMapStageR25bStaticAssembly Condition="'$(MiniMapStageR25bStaticAssembly)' == ''">false</MiniMapStageR25bStaticAssembly>
    <MiniMapStageR26aSpriteDiscovery Condition="'$(MiniMapStageR26aSpriteDiscovery)' == '' And '$(Configuration)' == 'Client Release'">true</MiniMapStageR26aSpriteDiscovery>
    <MiniMapStageR26aSpriteDiscovery Condition="'$(MiniMapStageR26aSpriteDiscovery)' == ''">false</MiniMapStageR26aSpriteDiscovery>
    <MiniMapStageR26bSpriteValidation Condition="'$(MiniMapStageR26bSpriteValidation)' == '' And '$(Configuration)' == 'Client Release'">true</MiniMapStageR26bSpriteValidation>
    <MiniMapStageR26bSpriteValidation Condition="'$(MiniMapStageR26bSpriteValidation)' == ''">false</MiniMapStageR26bSpriteValidation>
    <MiniMapUnrealEngineRoot Condition="'$(MiniMapUnrealEngineRoot)' == ''">$(ProgramW6432)\Epic Games\UE_5.6\</MiniMapUnrealEngineRoot>
    <StarRupturePluginSDKRoot>$(SolutionDir)..\..\StarRupture-Plugin-SDK\</StarRupturePluginSDKRoot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Release'">
    <StarRuptureSDKSourceDir>$(StarRupturePluginSDKRoot)StarRupture SDK\Server\SDK\</StarRuptureSDKSourceDir>
    <StarRuptureSDKConfigDir>$(StarRupturePluginSDKRoot)StarRupture SDK\Server\;$(StarRupturePluginSDKRoot)StarRupture SDK\Server\SDK\</StarRuptureSDKConfigDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Client Debug' Or '$(Configuration)' == 'Client Release'">
    <StarRuptureSDKSourceDir>$(StarRupturePluginSDKRoot)StarRupture SDK\Client\SDK\</StarRuptureSDKSourceDir>
    <StarRuptureSDKConfigDir>$(StarRupturePluginSDKRoot)StarRupture SDK\Client\;$(StarRupturePluginSDKRoot)StarRupture SDK\Client\SDK\</StarRuptureSDKConfigDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Server Debug' Or '$(Configuration)' == 'Server Release'">
    <StarRuptureSDKSourceDir>$(StarRupturePluginSDKRoot)StarRupture SDK\Server\SDK\</StarRuptureSDKSourceDir>
    <StarRuptureSDKConfigDir>$(StarRupturePluginSDKRoot)StarRupture SDK\Server\;$(StarRupturePluginSDKRoot)StarRupture SDK\Server\SDK\</StarRuptureSDKConfigDir>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Client Debug' Or '$(Configuration)' == 'Client Release'">
    <ClCompile><PreprocessorDefinitions>MODLOADER_CLIENT_BUILD;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Server Debug' Or '$(Configuration)' == 'Server Release'">
    <ClCompile><PreprocessorDefinitions>MODLOADER_SERVER_BUILD;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(MiniMapDebugUI)' == 'true'">
    <ClCompile><PreprocessorDefinitions>MINIMAP_DEBUG_UI=1;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(MiniMapDebugUI)' == 'true' And '$(MiniMapStageCVisuals)' == 'true'">
    <ClCompile><PreprocessorDefinitions>MINIMAP_STAGE_C_VISUALS_ENABLED=1;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(MiniMapAsyncReadbackExperiment)' == 'true' And ('$(Configuration)' == 'Client Release' Or '$(Configuration)' == 'Client Debug')">
    <ClCompile><PreprocessorDefinitions>MINIMAP_ASYNC_READBACK_EXPERIMENT=1;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(MiniMapStageR2SmelterCapture)' == 'true' And ('$(Configuration)' == 'Client Release' Or '$(Configuration)' == 'Client Debug')">
    <ClCompile><PreprocessorDefinitions>MINIMAP_STAGE_R2_SMELTER_CAPTURE=1;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(MiniMapStageR25bStaticAssembly)' == 'true' And '$(MiniMapStageR2SmelterCapture)' == 'true' And '$(Configuration)' == 'Client Release'">
    <ClCompile><PreprocessorDefinitions>MINIMAP_STAGE_R25B_STATIC_ASSEMBLY=1;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(MiniMapStageR26aSpriteDiscovery)' == 'true' And '$(Configuration)' == 'Client Release'">
    <ClCompile><PreprocessorDefinitions>MINIMAP_STAGE_R26A_SPRITE_DISCOVERY=1;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(MiniMapStageR26bSpriteValidation)' == 'true' And '$(MiniMapStageR26aSpriteDiscovery)' == 'true' And '$(MiniMapStageR2SmelterCapture)' == 'true' And '$(Configuration)' == 'Client Release'">
    <ClCompile><PreprocessorDefinitions>MINIMAP_STAGE_R26B_SPRITE_VALIDATION=1;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(MiniMapStageR26bSpriteValidation)' == 'true' And '$(MiniMapStageR26aSpriteDiscovery)' == 'true' And '$(MiniMapStageR2SmelterCapture)' == 'true' And '$(Configuration)' == 'Client Release'">
    <ClCompile><PreprocessorDefinitions>MINIMAP_STAGE_R26B4_CLASSIFICATION=1;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(MiniMapStageR26bSpriteValidation)' == 'true' And '$(MiniMapStageR25bStaticAssembly)' == 'true' And '$(Configuration)' == 'Client Release'">
    <ClCompile><PreprocessorDefinitions>MINIMAP_BUILDING_SPRITES=1;MINIMAP_STAGE_C_VISUALS_ENABLED=1;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile>
  </ItemDefinitionGroup>
</Project>
